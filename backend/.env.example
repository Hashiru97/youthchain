# Copy this file to .env and fill in real values. Never commit the real .env file.

# Set to "production" to enable Secure cookies and HSTS (see app.py). Leave
# as "development" for local http:// testing — Secure cookies are silently
# dropped by browsers over plain HTTP, which would break every login if this
# were left on locally.
#
# IMPORTANT — two things this app deliberately does NOT (and cannot, from
# application code alone) provide, and that any real deployment must supply:
#   1. TLS termination: this process expects to sit behind a reverse proxy
#      or cloud load balancer that terminates HTTPS (ProxyFix is configured
#      in app.py to trust that proxy's headers). Running this Flask process
#      directly on the public internet without one means everything —
#      passwords, JWTs, session cookies, uploaded CVs/certificates — travels
#      in plaintext.
#   2. Encryption at rest: SQLite has no built-in at-rest encryption. A real
#      deployment needs either a managed database with encryption-at-rest
#      enabled (e.g. a cloud-provider Postgres instance) or full-disk
#      encryption on the host, plus the same for wherever `uploads/` and
#      `backups/` end up living. Neither is something this codebase can turn
#      on by itself — it's an infrastructure/hosting decision.
FLASK_ENV=development

# Optional self-hosted secrets management (see docs/secrets-management.md
# and docker-compose.vault.yml). If both are set, JWT_SECRET_KEY and
# ADMIN_API_KEY below are fetched from Vault's KV v2 engine instead of
# read directly from this file — everything still works with these unset,
# falling back to the plain env vars exactly as before.
VAULT_ADDR=
VAULT_TOKEN=
VAULT_SECRET_PATH=youthchain/config

# Defaults to a local SQLite file if unset — fine for running `python
# app.py` directly on your own machine, but SQLite has a hard single-writer
# ceiling (Phase 3 #19/#20 of the engineering review; docs/load-testing.md
# measured a real 6.38% request failure rate under 30 concurrent writers,
# 0% on Postgres at identical load). docker-compose.yml/docker-compose.tls.yml
# already bundle Postgres and set this for you — leave it blank there. Set
# it here only to point at an EXTERNAL managed Postgres instead of the
# bundled container (the real production path — a single-node container
# with no managed backups/HA of its own is fine for local/staging, not for
# a national-scale launch), e.g.:
#   DATABASE_URL=postgresql://user:password@host:5432/youthchain
# The psycopg2-binary driver needed to actually connect is already in
# requirements.txt, so this is a config-only change, not a code change.
DATABASE_URL=

# Required in any shared/production environment. If unset locally, the app
# generates a random per-process key and prints a loud warning (see app.py) —
# fine for solo local development, NOT fine for anything else, since it
# invalidates every issued token on every restart and cannot be trusted.
JWT_SECRET_KEY=

# Optional SMTP for OTP emails. If unset, OTP codes are logged to the server
# console instead of being emailed (safe for local dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Set to 0 to disable the email-OTP gate on registration (local dev only).
ENFORCE_EMAIL_OTP_REG=1

# Which Hardhat network /issue_credential and /verify actually write to /
# read from (see _run_hardhat_script in app.py). Defaults to "localhost"
# (a Hardhat node on 127.0.0.1:8545 — the local dev workflow) if unset.
# Set this to a real network name matching an entry under
# blockchain/hardhat.config.js's `networks` (e.g. a `sepolia` entry you've
# added there) to actually write credential hashes to a real chain instead
# of a local ephemeral one — see blockchain/.env.example for the signer
# key (ISSUER_PRIVATE_KEY) that network will also need configured.
# HARDHAT_NETWORK=sepolia

# Backs OTP brute-force rate limiting with a real shared store (BL-09/S-04).
# If unset, rate limiting falls back to an in-memory, per-process dict —
# fine for local dev or a single backend instance, but each additional
# instance behind a load balancer would independently grant the same
# attempt budget without this set. Example:
#   REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Real malware scanning on uploads (CVs, certificates, employer
# verification documents, message attachments — see file_is_malware_free()
# in app.py and docker-compose.clamav.yml). If unset, uploads are
# validated for content-type match only (S-08), never scanned for
# malicious content — every one of those files is later downloaded by a
# DIFFERENT user (an employer reviewing an applicant, an admin reviewing a
# verification document), so this matters more than a typical single-user
# upload feature would. Example:
#   CLAMD_HOST=clamav
CLAMD_HOST=
CLAMD_PORT=3310

# Gates GET /admin/analytics (the reporting dashboard, BL-44) as a
# machine-to-machine auth path (curl/monitoring scripts) — pass it as
# ?key=... or an Authorization: Bearer header. Real, named operator
# accounts now also exist (see the Admin model in app.py) and are the
# primary path for a human visiting the dashboard in a browser: create one
# with
#   python scripts/create_admin.py --email you@org.org --name "Jane Doe"
# (prompts for a password interactively; there is no self-registration
# route for admin accounts, unlike Employer). If this key is unset AND no
# admin is logged in, the dashboard route 404s rather than existing at all.
ADMIN_API_KEY=

# --- Automated backups + off-site sync (see docker-compose.backup.yml) ---
# scripts/backup.py already works standalone with zero config (writes to
# backend/backups/ locally). These add real S3-compatible off-site upload
# (self-hosted MinIO via docker-compose.backup.yml, or a real cloud
# bucket — both speak the same S3 API) and are only used if ALL FOUR are
# set; otherwise backups stay local-only, exactly as before.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# How often backup-cron runs a backup, in seconds. Default 86400 (daily).
BACKUP_INTERVAL_SECONDS=86400
# How soon backup-cron retries after a FAILED attempt, in seconds --
# deliberately much shorter than the interval above, so a transient
# failure (Postgres briefly unreachable, a network blip on the S3 upload)
# self-heals in minutes rather than waiting out the full interval.
# Default 300 (5 minutes). See youthchain_backup_last_attempt_success /
# youthchain_backup_last_success_timestamp_seconds on GET /metrics for
# real-time backup health either way.
BACKUP_RETRY_SECONDS=300

# --- Push / SMS / WhatsApp notifications (BL-38) ---
# send_push_notification()/send_sms()/send_whatsapp() in app.py are real,
# live SDK integrations (Firebase Admin SDK / Twilio), gated on the vars
# below being set. Leave them unset and all three silently degrade to
# their original log-only stub behavior — nothing breaks, nothing is
# faked. In-app notifications (the Notification model, /api/notifications,
# and the Socket.IO "notification_created" event) always work regardless
# of any of these — they only gate the "reach a user when the app is
# closed" delivery channels.
#
# Push: requires a real Firebase project. Set this to either the path of
# the downloaded service-account JSON file, or the JSON content itself
# (useful on hosts that only offer single-line env vars, e.g.
# `FIREBASE_CREDENTIALS_JSON='{"type":"service_account",...}'`). The mobile
# app also needs its own google-services.json (Android) /
# GoogleService-Info.plist (iOS) bundled at build time and must call
# `PUT /api/push_token` with its FCM device token after login — neither of
# those is something this backend env var can supply.
FIREBASE_CREDENTIALS_JSON=

# SMS: requires a real Twilio account (or a compatible drop-in — Twilio's
# SDK is the one actually wired up in app.py). All three must be set
# together or SMS stays log-only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp: reuses the same Twilio account as SMS above (TWILIO_ACCOUNT_SID/
# TWILIO_AUTH_TOKEN), but needs two more pieces before send_whatsapp() in
# app.py will send anything real. Both unset = log-only, same as SMS.
#
# 1. TWILIO_WHATSAPP_FROM_NUMBER — a WhatsApp-enabled Twilio sender.
#    Cheapest path to get one working today: Twilio Console → Messaging →
#    Try it out → Send a WhatsApp message, which gives you the shared
#    Sandbox number (whatsapp:+14155238886) for development/testing —
#    each test phone must first send the sandbox's one-time join code
#    from WhatsApp before it will receive anything. A real production
#    sender is a separate step (Twilio Console → Messaging → Senders →
#    WhatsApp senders) requiring your own WhatsApp Business Profile.
TWILIO_WHATSAPP_FROM_NUMBER=
#
# 2. TWILIO_WHATSAPP_TEMPLATE_SID — WhatsApp's Business API rejects any
#    business-initiated message (which "a new job matches you" always is)
#    outside a 24h customer-service window unless it uses a pre-approved
#    Content Template. Create one at Twilio Console → Messaging → Content
#    Template Builder, category "Utility", with exactly one variable —
#    e.g. body text "A new job matches your search: {{1}}" — submit for
#    WhatsApp review (real external turnaround, typically under a day but
#    not guaranteed), then paste the resulting Content SID (starts "HX")
#    here once approved. send_whatsapp() sends variable {{1}} = the
#    matching job's title; changing the template's variable count/order
#    requires updating send_whatsapp()'s content_variables to match.
TWILIO_WHATSAPP_TEMPLATE_SID=

# --- Job scanner (Discover feed) ---
# scanner/firecrawl_client.py and scanner/claude_extractor.py are real,
# live API integrations, same "unset = fails loudly, not silently" posture
# as the rest of this file's optional integrations — a scan attempted
# without a real key here fails and records the failure on that scan_run,
# it does not crash the app or silently no-op. Get a key at
# https://www.firecrawl.dev and https://console.anthropic.com respectively.
#
# ANTHROPIC_API_KEY is also used by cv_generator.py to polish a
# candidate's generated CV (see GET /api/generate_cv/<id>) — unlike the
# scanner, this one degrades gracefully rather than failing when unset:
# the CV still generates in full, just from the candidate's own
# unpolished text instead of an AI-enhanced version (see
# polish_cv_content()'s own docstring).
FIRECRAWL_API_KEY=
ANTHROPIC_API_KEY=

# Set to "1" to run the poller that claims and executes scans queued by
# pg_cron (see migrations/versions/b6d3e81f5a97_enable_pg_cron_scan_scheduling.py) —
# every docker-compose*.yml sets this to "1" on the backend service
# already; only relevant to override for local `python app.py` testing.
# Safe to leave "1" even with no sources configured yet — it just never
# claims anything.
ENABLE_JOB_SCANNER_POLLER=0

# How often (seconds) each backend worker checks for a due scan to claim.
# pg_cron itself only queues new work every 5 minutes (see the migration
# above), so lowering this below single-digit seconds has no real benefit.
SCANNER_POLL_INTERVAL_SECONDS=30
