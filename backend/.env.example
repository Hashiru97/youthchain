# Copy this file to .env and fill in real values. Never commit the real .env file.

# Set to "production" to enable Secure cookies and HSTS (see app.py). Leave
# as "development" for local http:// testing — Secure cookies are silently
# dropped by browsers over plain HTTP, which would break every login if this
# were left on locally.
#
# IMPORTANT — two things this app deliberately does NOT (and cannot, from
# application code alone) provide, and that any real deployment must supply:
#   1. TLS termination: this process expects to sit behind a reverse proxy
#      or cloud load balancer that terminates HTTPS (ProxyFix is configured
#      in app.py to trust that proxy's headers). Running this Flask process
#      directly on the public internet without one means everything —
#      passwords, JWTs, session cookies, uploaded CVs/certificates — travels
#      in plaintext.
#   2. Encryption at rest: SQLite has no built-in at-rest encryption. A real
#      deployment needs either a managed database with encryption-at-rest
#      enabled (e.g. a cloud-provider Postgres instance) or full-disk
#      encryption on the host, plus the same for wherever `uploads/` and
#      `backups/` end up living. Neither is something this codebase can turn
#      on by itself — it's an infrastructure/hosting decision.
FLASK_ENV=development

# Required in any shared/production environment. If unset locally, the app
# generates a random per-process key and prints a loud warning (see app.py) —
# fine for solo local development, NOT fine for anything else, since it
# invalidates every issued token on every restart and cannot be trusted.
JWT_SECRET_KEY=

# Optional SMTP for OTP emails. If unset, OTP codes are logged to the server
# console instead of being emailed (safe for local dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Set to 0 to disable the email-OTP gate on registration (local dev only).
ENFORCE_EMAIL_OTP_REG=1
