# Python
venv/
__pycache__/
instance/

# Flask uploads
backend/uploads/
backend/backups/

# Node / Hardhat
blockchain/node_modules/
backend/node_modules/
blockchain/artifacts/
blockchain/cache/

# Flutter
# NOTE: these patterns previously said "flutter_app/", which doesn't match
# this project's actual directory name (youthchain_app/) — a latent bug
# that meant generated build artifacts were never actually excluded, only
# accidentally never committed. Fixed to match the real directory.
youthchain_app/build/
youthchain_app/.dart_tool/
youthchain_app/.idea/
youthchain_app/.fvm/

# System
.env
*.sqlite3
*.db
*.log
.DS_Store

# Firebase credentials -- real per-developer/per-environment secrets, never
# committed. google-services.json identifies the app to Google's servers
# (low-sensitivity but still environment-specific); the *-firebase-adminsdk-*
# key is a real service-account private key with server-side send privileges.
youthchain_app/android/app/google-services.json
youthchain_app/ios/Runner/GoogleService-Info.plist
*firebase-adminsdk*.json
